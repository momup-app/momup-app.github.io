{
  "name": "Kids Nearby Berlin",
  "short_name": "Kids Nearby",
  "description": "Activities, play events and kids' clothes sales in Berlin, close to home or online.",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "orientation": "portrait",
  "background_color": "#F7F4FA",
  "theme_color": "#8670D6",
  "lang": "de",
  "categories": [
    "kids",
    "lifestyle",
    "education"
  ],
  "icons": [
    {
      "src": "images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "images/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "images/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Kids' clothes sales",
      "short_name": "Sales",
      "url": "./?category=sales&source=app",
      "icons": [
        {
          "src": "images/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Mom chat",
      "short_name": "Chat",
      "url": "./chat.html?source=app",
      "icons": [
        {
          "src": "images/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My account",
      "short_name": "Account",
      "url": "./account.html?source=app",
      "icons": [
        {
          "src": "images/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://momup-app.github.io/manifest.webmanifest"
    }
  ]
}
